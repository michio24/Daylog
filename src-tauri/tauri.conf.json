{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daylog",
  "version": "1.0.0",
  "identifier": "local.daylog.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Daylog", "width": 1120, "height": 820, "minWidth": 720, "minHeight": 600, "resizable": true, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https: daylog-attachment: http://daylog-attachment.localhost; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "nsis", "icon": ["icons/icon.ico"] }
}
